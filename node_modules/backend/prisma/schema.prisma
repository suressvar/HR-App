generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         Role
  createdAt    DateTime      @default(now())
  employee     Employee?
  owner        OwnerProfile?
}

model Employee {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  email     String
  phone     String
  address   String
  role      String
  status    String   @default("ACTIVE")
  tasks     Task[]
  createdAt DateTime @default(now())
}

model OwnerProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  name         String
  email        String
  phone        String
  personalInfo String?
}

model Task {
  id              String        @id @default(uuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  title           String
  description     String
  dueDate         DateTime
  status          TaskStatus    @default(PENDING)
  priority        Priority      @default(MEDIUM)
  estimatedHours  Float?
  category        String?
  completionNotes String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  frequency       TaskFrequency @default(ONE_TIME)
}

enum Role {
  OWNER
  EMPLOYEE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  OVERDUE
}

enum TaskFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  YEARLY
}

